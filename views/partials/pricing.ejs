<script>
(function() {
  var annual = true;
  var toggle = document.getElementById('billing-toggle');
  var thumb = document.getElementById('toggle-thumb');
  var annualLabel = document.getElementById('toggle-annual-label');
  var monthlyLabel = document.getElementById('toggle-monthly-label');

  var prices = {
    solo:   { annual: ['1,488', '/year', 'or €149/mo billed annually — save 2 months'], monthly: ['149', '/mo', 'billed month-to-month'] },
    team:   { annual: ['3,492', '/year', 'or €349/mo billed annually — save 2 months'], monthly: ['349', '/mo', 'billed month-to-month'] },
    ent:    { annual: ['7,992', '/year', 'or €799/mo billed annually — save 2 months'], monthly: ['799', '/mo', 'billed month-to-month'] }
  };

  // CTA elements (injected by this script)
  var ctas = {};

  function initCTAs() {
    ctas.solo = document.querySelector('.pricing-card:nth-child(1) .card-cta');
    ctas.team = document.querySelector('.pricing-card:nth-child(2) .card-cta');
    ctas.ent  = document.querySelector('.pricing-card:nth-child(3) .card-cta');
  }

  function updateCTAs() {
    // CTAs now point to /signup — no dynamic URL swapping needed
  }

  function updateUI() {
    var plans = ['solo', 'team', 'ent'];
    plans.forEach(function(p) {
      var pdata = prices[p];
      var mode = annual ? 'annual' : 'monthly';
      var parts = pdata[mode];
      document.getElementById(p + '-price').querySelector('.price-amount').textContent = parts[0];
      document.getElementById(p + '-price').querySelector('.price-period').textContent = parts[1];
      document.getElementById(p + '-sub').textContent = parts[2];
    });
    annualLabel.classList.toggle('inactive', !annual);
    monthlyLabel.classList.toggle('inactive', annual);
    toggle.setAttribute('aria-checked', annual ? 'true' : 'false');
    updateCTAs();
  }

  toggle.addEventListener('click', function() {
    annual = !annual;
    updateUI();
  });

  toggle.addEventListener('keydown', function(e) {
    if (e.key === ' ' || e.key === 'Enter') {
      e.preventDefault();
      annual = !annual;
      updateUI();
    }
  });

  // Init on load
  initCTAs();
  updateCTAs();
})();
</script>