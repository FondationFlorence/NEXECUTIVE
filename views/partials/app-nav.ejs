<header class="app-topbar">
  <div class="app-topbar-inner">
    <a href="/dashboard" class="app-brand"><img src="/brand/bildup-mark.svg" alt="" width="22" height="22" style="vertical-align:-5px;margin-right:8px">BildUp</a>
    <nav class="app-nav">
      <a href="/dashboard" class="<%= nav === 'dashboard' ? 'active' : '' %>">Tableau de bord</a>
      <a href="/targets"   class="<%= nav === 'targets' ? 'active' : '' %>">Cibles</a>
      <a href="/alerts"    class="<%= nav === 'alerts' ? 'active' : '' %>">Alertes</a>
      <a href="/pipeline"  class="<%= nav === 'pipeline' ? 'active' : '' %>">Pipeline</a>
      <a href="/settings"  class="<%= nav === 'settings' ? 'active' : '' %>">Réglages</a>
    </nav>
    <div class="app-user">
      <% if (typeof trial !== 'undefined' && trial && !trial.isPaid) { %>
        <a href="/#pricing" class="trial-pill <%= trial.isExpired ? 'expired' : '' %>">
          <%= trial.isExpired ? 'Essai terminé — passez à l’offre' : 'Essai : ' + trial.daysRemaining + ' j restants' %>
        </a>
      <% } %>
      <span class="app-user-name"><%= user.name || user.email %></span>
      <form method="post" action="/api/auth/logout" class="app-signout-form">
        <button type="submit" class="app-signout">Déconnexion</button>
      </form>
    </div>
  </div>
</header>
