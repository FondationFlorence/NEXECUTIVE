<%- include('../partials/app-head', { title: 'Cibles — BildUp' }) %>
<%- include('../partials/app-nav') %>

<main class="app-shell">
  <div class="page-head">
    <div>
      <p class="eyebrow">Moteur de criblage</p>
      <h1 class="page-title">Univers de cibles</h1>
      <p class="page-sub"><%= fmt.num(total) %> cibles du lower-mid-market · chaque fiche reliée à son registre officiel</p>
    </div>
  </div>

  <form method="get" action="/targets" class="filters">
    <input type="search" name="q" placeholder="Rechercher un nom ou une description…" value="<%= filters.q %>">
    <select name="sector">
      <option value="">Tous les secteurs</option>
      <% sectors.forEach(function(s){ %><option value="<%= s %>" <%= filters.sector === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
    <select name="country">
      <option value="">Tous les pays</option>
      <% countries.forEach(function(c){ %><option value="<%= c %>" <%= filters.country === c ? 'selected' : '' %>><%= fmt.country(c) %></option><% }) %>
    </select>
    <select name="ownership">
      <option value="">Toute détention</option>
      <% ownerships.forEach(function(o){ %><option value="<%= o %>" <%= filters.ownership === o ? 'selected' : '' %>><%= fmt.ownership(o) %></option><% }) %>
    </select>
    <button type="submit" class="btn btn-sm">Filtrer</button>
    <a href="/targets" class="btn btn-sm btn-ghost">Réinitialiser</a>
  </form>

  <section class="panel">
    <% if (companies.length === 0) { %>
      <div class="empty"><h3>Aucun résultat</h3><p>Élargissez vos filtres.</p></div>
    <% } else { %>
      <% companies.forEach(function(c) { %>
        <div class="target-row">
          <div class="target-main">
            <a href="/company/<%= c.slug %>" class="target-name"><%= c.name %></a>
            <div class="target-meta">
              <span class="tag sector"><%= c.sector %></span>
              <span class="dot"><%= c.hq_city ? c.hq_city + ', ' : '' %><%= fmt.country(c.country) %></span>
              <span class="dot"><%= fmt.eur(c.revenue_eur) %> de CA</span>
              <% if (c.owner_age) { %><span class="dot">propriétaire <%= c.owner_age %> ans</span><% } %>
              <% if (c.availability) { %><span class="tag signal"><%= fmt.availability(c.availability) %></span><% } %>
              <% if (c.registry_url) { %><a class="src-link" href="<%= c.registry_url %>" target="_blank" rel="noopener"><%= c.registry %></a><% } %>
            </div>
          </div>
          <div class="target-side">
            <% if (hasThesis) { %><span class="match-badge <%= c.match.match >= 70 ? 'strong' : '' %>"><%= c.match.match %>%</span><% } %>
            <span class="score score-<%= c.score.band.toLowerCase() %>"><b><%= c.score.total %></b>/100</span>
            <% if (watchedIds.has(c.id)) { %>
              <form method="post" action="/app/watchlist/remove" class="inline-form">
                <input type="hidden" name="company_id" value="<%= c.id %>">
                <input type="hidden" name="return_to" value="/targets">
                <button type="submit" class="btn btn-sm btn-ghost">Suivie ✓</button>
              </form>
            <% } else { %>
              <form method="post" action="/app/watchlist/add" class="inline-form">
                <input type="hidden" name="company_id" value="<%= c.id %>">
                <input type="hidden" name="return_to" value="/targets">
                <button type="submit" class="btn btn-sm">+ Suivre</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </section>
</main>
</body>
</html>
