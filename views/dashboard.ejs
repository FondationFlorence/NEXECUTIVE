<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Nexecutive</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { min-height: 100vh; background: var(--navy-deep); }
    .dashboard-page { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; }

    .dash-header {
      padding: 1.1rem 3rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(10, 15, 30, 0.88);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--navy-border);
    }

    .dash-logo {
      font-family: 'DM Serif Display', serif;
      font-size: 1.05rem;
      color: var(--text-primary);
    }

    .dash-nav { display: flex; align-items: center; gap: 1.5rem; }

    .dash-nav-link {
      font-size: 0.82rem;
      color: var(--text-secondary);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.15s ease;
    }
    .dash-nav-link:hover { color: var(--gold); }

    .dash-signout {
      font-size: 0.82rem;
      color: var(--text-muted);
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      transition: color 0.15s ease;
    }
    .dash-signout:hover { color: var(--gold); }

    .dash-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem 3rem;
    }

    .dash-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 12px;
      padding: 3rem 2.5rem;
      width: 100%;
      max-width: 560px;
      backdrop-filter: blur(24px);
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
      text-align: center;
    }

    .dash-trial-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(201, 168, 76, 0.1);
      border: 1px solid rgba(201, 168, 76, 0.25);
      border-radius: 20px;
      padding: 0.35rem 1rem;
      font-size: 0.68rem;
      color: var(--gold);
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 1.75rem;
    }

    .dash-headline {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      font-weight: 400;
      font-style: italic;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      line-height: 1.15;
    }

    .dash-welcome {
      font-size: 0.9rem;
      color: var(--text-muted);
      font-weight: 300;
      margin-bottom: 2.5rem;
    }

    .dash-status-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 2.5rem;
      text-align: left;
    }

    .status-item {
      background: rgba(13, 20, 36, 0.7);
      border: 1px solid var(--navy-border);
      border-radius: 8px;
      padding: 1rem 1.25rem;
    }

    .status-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold-dim);
      margin-bottom: 0.4rem;
    }

    .status-value {
      font-family: 'DM Serif Display', serif;
      font-size: 1.3rem;
      color: var(--text-primary);
      line-height: 1;
    }

    .status-value.gold { color: var(--gold); }

    .dash-cta {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: var(--gold);
      color: var(--navy-deep);
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease, box-shadow 0.15s ease;
      letter-spacing: 0.02em;
    }

    .dash-cta:hover {
      background: var(--gold-bright);
      box-shadow: 0 0 24px rgba(201, 168, 76, 0.3);
    }

    .dash-expired-cta {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: transparent;
      color: var(--gold);
      border: 1px solid var(--navy-border-hover);
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease, border-color 0.15s ease;
      letter-spacing: 0.02em;
    }

    .dash-expired-cta:hover {
      background: var(--gold-glow);
      border-color: var(--gold);
    }

    .dash-footer-note {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .dash-footer-note a { color: var(--gold-dim); text-decoration: none; }
    .dash-footer-note a:hover { color: var(--gold); }

    @media (max-width: 600px) {
      .dash-header { padding: 0.9rem 1.5rem; }
      .dash-content { padding: 3rem 1.5rem; }
      .dash-status-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="dashboard-page">
    <header class="dash-header">
      <span class="dash-logo">Nexecutive</span>
      <nav class="dash-nav">
        <a href="/#pricing" class="dash-nav-link">Pricing</a>
        <form method="post" action="/api/auth/logout" style="display:inline">
          <button type="submit" class="dash-signout">Sign Out</button>
        </form>
      </nav>
    </header>

    <main class="dash-content">
      <div class="dash-card">
        <% const trialStart = user.trial_start_date ? new Date(user.trial_start_date) : new Date(); %>
        <% const daysUsed = Math.floor((Date.now() - trialStart) / (1000 * 60 * 60 * 24)); %>
        <% const daysRemaining = 14 - daysUsed; %>
        <% const isExpired = daysRemaining <= 0; %>

        <div class="dash-trial-badge">
          <% if (isExpired) { %>
            Trial Ended
          <% } else { %>
            &#10003; Free Trial Active
          <% } %>
        </div>

        <% if (isExpired) { %>
          <h1 class="dash-headline">Your free trial has ended</h1>
          <p class="dash-welcome">Subscribe to continue accessing Nexecutive's M&A intelligence.</p>
        <% } else { %>
          <h1 class="dash-headline">You're on a 14-day free trial</h1>
          <p class="dash-welcome"><%= user.name ? 'Welcome, ' + user.name + '.' : 'Welcome.' %> Full access for <%= daysRemaining %> more day<%= daysRemaining === 1 ? '' : 's' %>.</p>
        <% } %>

        <div class="dash-status-grid">
          <div class="status-item">
            <div class="status-label">Plan</div>
            <div class="status-value">Solo <span style="color: var(--gold-dim); font-size: 0.85rem;">(trial)</span></div>
          </div>
          <div class="status-item">
            <div class="status-label">Trial Status</div>
            <div class="status-value <%= isExpired ? '' : 'gold' %>">
              <% if (isExpired) { %>
                Expired
              <% } else { %>
                <%= daysRemaining %> day<%= daysRemaining === 1 ? '' : 's' %> left
              <% } %>
            </div>
          </div>
        </div>

        <% if (isExpired) { %>
          <a href="/#pricing" class="dash-expired-cta">Subscribe now</a>
        <% } else { %>
          <a href="/#pricing" class="dash-cta">Upgrade now</a>
        <% } %>

        <p class="dash-footer-note">
          No credit card required during trial &mdash;
          <a href="mailto:hello@nexecutive.com">cancel anytime</a>
        </p>
      </div>
    </main>
  </div>
</body>
</html>